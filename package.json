{
  "name": "openpanda",
  "version": "1.0.0",
  "private": true,
  "description": "OpenPanda - 个人技术交流平台 (ViteTS + Gin + PostgreSQL + Redis)",
  "scripts": {
    "dev:frontend": "cd Frontend && npm run dev",
    "dev:backend": "cd Backend && go run .",
    "build:frontend": "cd Frontend && npm run build",
    "build:backend": "cd Backend && go build -ldflags=\"-w -s\" -o server .",
    "check:frontend": "npm --prefix Frontend run check",
    "test:backend": "cd Backend && go test -race ./...",
    "build:backend:local": "cd Backend && go build -ldflags=\"-w -s\" -o server.exe main.go",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d",
    "docker:down": "docker compose -f deploy/docker-compose.yml down",
    "docker:logs": "docker compose -f deploy/docker-compose.yml logs -f",
    "docker:build:backend": "docker build -t crpi-c5c3flmci79oobwt.cn-shanghai.personal.cr.aliyuncs.com/clintonluo/openpanda-backend:latest ./Backend",
    "docker:build:frontend": "npm run build:frontend && docker build -t crpi-c5c3flmci79oobwt.cn-shanghai.personal.cr.aliyuncs.com/clintonluo/openpanda-frontend:latest ./Frontend",
    "docker:build": "npm run docker:build:backend && npm run docker:build:frontend",
    "docker:push:backend": "docker push crpi-c5c3flmci79oobwt.cn-shanghai.personal.cr.aliyuncs.com/clintonluo/openpanda-backend:latest",
    "docker:push:frontend": "docker push crpi-c5c3flmci79oobwt.cn-shanghai.personal.cr.aliyuncs.com/clintonluo/openpanda-frontend:latest",
    "docker:push": "npm run docker:push:backend && npm run docker:push:frontend",
    "docker:release": "npm run docker:build && npm run docker:push"
  }
}
